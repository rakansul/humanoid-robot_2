from typing import Any

import config
from object_selection import SelectedObject
from red_zone_detector import RedZone

class ROSManipulationController:
    """
    ROS 2 adapter used to publish camera-based target poses to the arm interface.
    """

    def __init__(self) -> None:
        self._rclpy: Any = None
        self._node: Any = None
        self._pose_stamped_cls: Any = None
        self._right_arm_target_pub: Any = None
        self._left_arm_target_pub: Any = None
        self._dry_run = False

    def initialize(self) -> None:
        try:
            import rclpy
            from geometry_msgs.msg import PoseStamped
        except ImportError:
            self._dry_run = True
            print("ROSManipulationController dry-run mode")
            return

        self._rclpy = rclpy
        self._pose_stamped_cls = PoseStamped

        if not rclpy.ok():
            rclpy.init(args=None)

        self._node = rclpy.create_node("robot_mission_manipulation_bridge")

        self._right_arm_target_pub = self._node.create_publisher(
            PoseStamped,
            config.ROS_MANIPULATION.right_arm_target_topic,
            10,
        )

        self._left_arm_target_pub = self._node.create_publisher(
            PoseStamped,
            config.ROS_MANIPULATION.left_arm_target_topic,
            10,
        )

    def pick_object(self, selected_object: SelectedObject) -> bool:
        if selected_object.position_3d_m is None:
            print("Cannot publish pick target: selected object has no RealSense XYZ.")
            return False

        return self._publish_camera_xyz_target(
            xyz=selected_object.position_3d_m,
            label=selected_object.label,
            use_right_arm=True,
        )

    def _publish_camera_xyz_target(
        self,
        xyz: tuple[float, float, float],
        label: str,
        use_right_arm: bool,
    ) -> bool:
        if self._dry_run or self._node is None or self._pose_stamped_cls is None:
            print(f"ROS dry-run: would publish {label} XYZ target {xyz}")
            return True

        msg = self._pose_stamped_cls()
        msg.header.frame_id = config.ROS_MANIPULATION.camera_frame_id
        msg.header.stamp = self._node.get_clock().now().to_msg()

        msg.pose.position.x = float(xyz[0])
        msg.pose.position.y = float(xyz[1])
        msg.pose.position.z = float(xyz[2])
        msg.pose.orientation.w = 1.0

        publisher = self._right_arm_target_pub
        publisher.publish(msg)

        return True

    def place_object(self, red_zone: RedZone) -> bool:
        print(f"Right arm ROS command: place object at {red_zone.center_pixel}")
        return True

    def shutdown(self) -> None:
        if self._node is not None:
            self._node.destroy_node()
            self._node = None

        if self._rclpy is not None and self._rclpy.ok():
            self._rclpy.shutdown()

        print("ROSManipulationController shutdown complete")
