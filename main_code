from dataclasses import dataclass
from pathlib import Path
from typing import Any

from config import VisionConfig
from utils import Detection

@dataclass(frozen=True)
class VisionFrame:
    color: Any
    depth_frame: Any = None
    depth_intrinsics: Any = None

class VisionSystem:
    """
    Camera and YOLO object detection module.
    The primary setup uses Intel RealSense RGB-D input and YOLO inference.
    """

    def __init__(self, config: VisionConfig) -> None:
        self.config = config
        self._camera: Any = None
        self._model: Any = None
        self._cv2: Any = None
        self._rs: Any = None
        self._pipeline: Any = None
        self._align: Any = None
        self._using_realsense = False
        self._latest_detections: list[Detection] = []

    def initialize(self) -> None:
        import cv2
        self._cv2 = cv2
        self._load_yolo_model()

        if self.config.camera_backend == "realsense":
            try:
                self._initialize_realsense()
                print("VisionSystem initialized with Intel RealSense RGB + depth")
                return
            except Exception as exc:
                print(f"Could not initialize Intel RealSense: {exc}")
                if not self.config.fallback_to_opencv:
                    raise

        self._initialize_opencv_camera()
        print("VisionSystem initialized with OpenCV camera fallback")

    def _load_yolo_model(self) -> None:
        from ultralytics import YOLO
        model_path = self._resolve_model_path()
        self._model = YOLO(str(model_path))
        print(f"{self.config.yolo_version} model loaded from {model_path}")

    def _resolve_model_path(self) -> Path:
        candidates = [self.config.model_path, self.config.raspberry_pi_model_path]
        for path in candidates:
            if path.exists():
                return path
        return Path(self.config.model_name)

    def _initialize_realsense(self) -> None:
        import pyrealsense2 as rs

        self._rs = rs
        pipeline = rs.pipeline()
        stream_config = rs.config()
        stream_config.enable_stream(
            rs.stream.color,
            self.config.frame_width,
            self.config.frame_height,
            rs.format.bgr8,
            self.config.frame_rate,
        )
        stream_config.enable_stream(
            rs.stream.depth,
            self.config.frame_width,
            self.config.frame_height,
            rs.format.z16,
            self.config.frame_rate,
        )

        pipeline.start(stream_config)
        self._pipeline = pipeline
        self._align = rs.align(rs.stream.color)
        self._using_realsense = True

    def _initialize_opencv_camera(self) -> None:
        self._camera = self._cv2.VideoCapture(self.config.camera_index)
        self._camera.set(self._cv2.CAP_PROP_FRAME_WIDTH, self.config.frame_width)
        self._camera.set(self._cv2.CAP_PROP_FRAME_HEIGHT, self.config.frame_height)

        if not self._camera.isOpened():
            raise RuntimeError("Could not open camera")

    def get_frame(self) -> VisionFrame | None:
        if self._using_realsense:
            return self._get_realsense_frame()

        if self._camera is None:
            return None

        success, frame = self._camera.read()
        if not success:
            return None
        return VisionFrame(color=frame)

    def _get_realsense_frame(self) -> VisionFrame | None:
        frames = self._pipeline.wait_for_frames()
        aligned_frames = self._align.process(frames)
        color_frame = aligned_frames.get_color_frame()
        depth_frame = aligned_frames.get_depth_frame()

        if not color_frame or not depth_frame:
            return None

        import numpy as np
        color = np.asanyarray(color_frame.get_data())
        depth_intrinsics = depth_frame.profile.as_video_stream_profile().intrinsics

        return VisionFrame(
            color=color,
            depth_frame=depth_frame,
            depth_intrinsics=depth_intrinsics,
        )
