from dataclasses import dataclass
from typing import Iterable

from utils import Detection

@dataclass(frozen=True)
class SelectedObject:
    label: str
    confidence: float
    bbox: tuple[int, int, int, int]
    center_pixel: tuple[int, int]
    distance_m: float | None
    position_3d_m: tuple[float, float, float] | None
    reason: str

    @property
    def xyz_text(self) -> str:
        if self.position_3d_m is None:
            return "xyz=unknown"
        x_m, y_m, z_m = self.position_3d_m
        return f"xyz=({x_m:.3f}, {y_m:.3f}, {z_m:.3f})m"

class ObjectSelector:
    """Choose the closest valid pickup object."""

    def __init__(
        self,
        frame_width: int = 640,
        allowed_objects: tuple[str, ...] | None = None,
    ) -> None:
        self.frame_width = frame_width
        self.allowed_objects = allowed_objects or (
            "cup",
            "bottle",
            "can",
            "coffee_cup",
            "water_bottle",
            "soda_can",
        )

    def select(
        self,
        detections_or_snapshot: Iterable[Detection] | object,
    ) -> SelectedObject | None:
        detections = self._extract_detections(detections_or_snapshot)

        matches = [
            detection
            for detection in detections
            if detection.label in self.allowed_objects
        ]

        if not matches:
            return None

        best = min(matches, key=self._distance_key)

        return SelectedObject(
            label=best.label,
            confidence=best.confidence,
            bbox=best.bbox,
            center_pixel=best.center,
            distance_m=best.distance_m,
            position_3d_m=best.position_3d_m,
            reason=f"Selected closest visible object: {best.label}.",
        )

    def _extract_detections(
        self,
        detections_or_snapshot: Iterable[Detection] | object,
    ) -> list[Detection]:
        snapshot_detections = getattr(detections_or_snapshot, "detections", None)
        if snapshot_detections is not None:
            return list(snapshot_detections)
        return list(detections_or_snapshot)

    def _distance_key(self, detection: Detection) -> tuple[int, float]:
        if detection.distance_m is not None:
            return (0, detection.distance_m)

        area = max(1, detection.width * detection.height)
        return (1, 1.0 / area)
