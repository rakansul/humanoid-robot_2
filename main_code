B.9 Main Mission Entry Point - main_mission.py

```python
import config

from object_selection import ObjectSelector
from platform_controller import PlatformController
from red_zone_detector import RedZoneDetector
from ros_manipulation_controller import ROSManipulationController
from table_mission_executor import TableMissionExecutor
from vision import VisionSystem

def main() -> None:
    platform = PlatformController(config.PLATFORM)
    vision = VisionSystem(config.VISION)
    manipulator = ROSManipulationController()
    red_zone_detector = RedZoneDetector()

    object_selector = ObjectSelector(
        frame_width=config.VISION.frame_width,
        allowed_objects=config.MISSION.pickup_object_classes,
    )

    try:
        platform.initialize()
        vision.initialize()
        manipulator.initialize()

        mission = TableMissionExecutor(
            platform=platform,
            vision=vision,
            manipulator=manipulator,
            red_zone_detector=red_zone_detector,
            object_selector=object_selector,
        )

        result = mission.run()
        print(f"Mission result: success={result.success} | {result.message}")

    except KeyboardInterrupt:
        print("Ctrl+C received. Enabling platform emergency stop.")
        platform.emergency_stop(True)

    finally:
        platform.shutdown()
        manipulator.shutdown()
        vision.shutdown()
        print("main_mission shutdown complete")

if __name__ == "__main__":
    main()
