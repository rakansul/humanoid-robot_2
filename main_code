B.3 YOLO Detection and Depth Estimation - vision.py

```python
class VisionSystem:
    def detect(self, frame: VisionFrame | Any) -> list[Detection]:
        if frame is None or self._model is None:
            return []

        if not isinstance(frame, VisionFrame):
            frame = VisionFrame(color=frame)

        self._latest_detections = self._run_yolo(frame)
        return self._latest_detections

    def _run_yolo(self, frame: VisionFrame) -> list[Detection]:
        results = self._model.predict(
            frame.color,
            conf=self.config.confidence_threshold,
            imgsz=self.config.imgsz,
            device=self.config.device,
            iou=self.config.yolo_iou_threshold,
            max_det=self.config.yolo_max_detections,
            verbose=False,
        )

        detections: list[Detection] = []
        allowed_classes = set(self.config.detection_classes)

        for result in results:
            names = result.names
            for box in result.boxes:
                confidence = float(box.conf[0])
                class_id = int(box.cls[0])
                label = names.get(class_id, str(class_id))

                if label not in allowed_classes:
                    continue

                x1, y1, x2, y2 = [int(value) for value in box.xyxy[0]]
                center_pixel = ((x1 + x2) // 2, (y1 + y2) // 2)

                distance_m, position_3d_m = self._estimate_depth(
                    frame,
                    center_pixel,
                )

                detections.append(
                    Detection(
                        label=label,
                        confidence=confidence,
                        bbox=(x1, y1, x2, y2),
                        center_pixel=center_pixel,
                        distance_m=distance_m,
                        position_3d_m=position_3d_m,
                    )
                )

        return detections

    def _estimate_depth(
        self,
        frame: VisionFrame,
        center_pixel: tuple[int, int],
    ) -> tuple[float | None, tuple[float, float, float] | None]:
        if frame.depth_frame is None or frame.depth_intrinsics is None:
            return None, None

        cx, cy = center_pixel
        distance_m = float(frame.depth_frame.get_distance(cx, cy))

        if distance_m <= 0:
            return None, None

        point = self._rs.rs2_deproject_pixel_to_point(
            frame.depth_intrinsics,
            [cx, cy],
            distance_m,
        )

        position_3d_m = (
            round(point[0], 3),
            round(point[1], 3),
            round(point[2], 3),
        )

        return round(distance_m, 3), position_3d_m
