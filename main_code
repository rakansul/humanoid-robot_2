from dataclasses import dataclass
from enum import StrEnum
from time import sleep

import config

class TableMissionState(StrEnum):
    IDLE = "IDLE"
    GO_TO_TABLE_1 = "GO_TO_TABLE_1"
    WAIT_FOR_TABLE_1 = "WAIT_FOR_TABLE_1"
    DETECT_OBJECT = "DETECT_OBJECT"
    PICK_OBJECT = "PICK_OBJECT"
    GO_TO_TABLE_2 = "GO_TO_TABLE_2"
    WAIT_FOR_TABLE_2 = "WAIT_FOR_TABLE_2"
    DETECT_RED_ZONE = "DETECT_RED_ZONE"
    PLACE_OBJECT = "PLACE_OBJECT"
    VERIFY_PLACEMENT = "VERIFY_PLACEMENT"
    DONE = "DONE"
    ERROR = "ERROR"
    EMERGENCY_STOP = "EMERGENCY_STOP"

@dataclass(frozen=True)
class TableMissionResult:
    success: bool
    state: TableMissionState
    message: str
    selected_object: object | None = None
    red_zone: object | None = None

class TableMissionExecutor:
    """
    Coordinates platform navigation, YOLO perception, and ROS manipulation.
    """

    def __init__(
        self,
        platform,
        vision,
        manipulator,
        red_zone_detector,
        object_selector,
    ) -> None:
        self.platform = platform
        self.vision = vision
        self.manipulator = manipulator
        self.red_zone_detector = red_zone_detector
        self.object_selector = object_selector
        self.state = TableMissionState.IDLE
        self.selected_object = None
        self.red_zone = None

    def run(self) -> TableMissionResult:
        try:
            self._set_state(TableMissionState.GO_TO_TABLE_1)
            self.platform.go_to_table_1()

            self._set_state(TableMissionState.WAIT_FOR_TABLE_1)
            table_1_result = self.platform.wait_until_arrived(
                config.PLATFORM.table_1_poi
            )

            if not table_1_result.reached:
                return self._fail(f"Could not reach table_1: {table_1_result.text}")

            self._set_state(TableMissionState.DETECT_OBJECT)
            self.selected_object = self._detect_closest_object()

            if self.selected_object is None:
                return self._fail("No valid pickup object detected on table_1.")

            self._set_state(TableMissionState.PICK_OBJECT)
            self.manipulator.look_at_target(self.selected_object)

            if not self.manipulator.pick_object(self.selected_object):
                return self._fail("ROS arm failed to pick the selected object.")

            self._set_state(TableMissionState.GO_TO_TABLE_2)
            self.platform.go_to_table_2()

            self._set_state(TableMissionState.WAIT_FOR_TABLE_2)
            table_2_result = self.platform.wait_until_arrived(
                config.PLATFORM.table_2_poi
            )

            if not table_2_result.reached:
                return self._fail(f"Could not reach table_2: {table_2_result.text}")

            self._set_state(TableMissionState.DETECT_RED_ZONE)
            self.red_zone = self._detect_red_zone()

            if self.red_zone is None:
                return self._fail("No red placement area detected on table_2.")

            self._set_state(TableMissionState.PLACE_OBJECT)
            self.manipulator.place_object(self.red_zone)

            self._set_state(TableMissionState.VERIFY_PLACEMENT)
            if not self._verify_placement():
                return self._fail("Placement verification failed.")

            self._set_state(TableMissionState.DONE)

            return TableMissionResult(
                success=True,
                state=self.state,
                message="Mission completed successfully.",
                selected_object=self.selected_object,
                red_zone=self.red_zone,
            )

        except KeyboardInterrupt:
            self._set_state(TableMissionState.EMERGENCY_STOP)
            self.platform.emergency_stop(True)
            return self._fail("Mission interrupted; emergency stop enabled.")

        except Exception as exc:
            return self._fail(f"Mission error: {exc}")

    def _detect_closest_object(self, attempts: int | None = None):
        attempts = attempts or config.MISSION.object_detection_attempts

        for _ in range(attempts):
            frame = self.vision.get_frame()
            detections = self.vision.detect(frame)
            selected = self.object_selector.select(detections)

            if selected is not None:
                return selected

            sleep(config.MISSION.loop_delay_seconds)

        return None

    def _set_state(self, state: TableMissionState) -> None:
        self.state = state
        print(f"MISSION STATE -> {state.value}")

    def _fail(self, message: str) -> TableMissionResult:
        self._set_state(TableMissionState.ERROR)
        print(f"MISSION FAILED: {message}")

        return TableMissionResult(
            success=False,
            state=self.state,
            message=message,
            selected_object=self.selected_object,
            red_zone=self.red_zone,
        )
