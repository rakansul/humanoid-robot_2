from dataclasses import dataclass
from time import monotonic, sleep

from config import PlatformConfig
from platform_protocol import PlatformProtocol

@dataclass(frozen=True)
class NavigationResult:
    reached: bool
    status: int | None
    text: str
    target_name: str

class PlatformController:
    """
    High-level controller for the Wi-Fi WebSocket mobile platform.
    """

    def __init__(self, config: PlatformConfig) -> None:
        self.config = config
        self.protocol = PlatformProtocol(config)
        self._last_navigation_status: int | None = None
        self._last_navigation_text = ""

    def initialize(self) -> None:
        self.protocol.connect()

        self.protocol.subscribe(
            topic=self.config.navi_status_topic,
            message_type=self.config.navi_status_type,
            message_id="get_navi_status",
        )

        self.protocol.subscribe(
            topic=self.config.robot_status_topic,
            message_type=self.config.robot_status_type,
            message_id="get_robot_status",
            throttle_rate=500,
        )

        print("PlatformController initialized for WebSocket POI navigation")

    def go_to_table_1(self) -> NavigationResult:
        return self.go_to_poi(self.config.table_1_poi)

    def go_to_table_2(self) -> NavigationResult:
        return self.go_to_poi(self.config.table_2_poi)

    def go_to_poi(self, poi_name: str) -> NavigationResult:
        response = self.protocol.call_service(
            service=self.config.poi_service,
            args={"poi": poi_name},
            message_id=f"service_poi_{poi_name}",
            timeout_seconds=self.config.response_timeout_seconds,
        )

        if response is None:
            return NavigationResult(
                reached=False,
                status=None,
                text="POI request sent; no immediate service response received.",
                target_name=poi_name,
            )

        return NavigationResult(
            reached=False,
            status=None,
            text="POI request accepted.",
            target_name=poi_name,
        )

    def wait_until_arrived(self, poi_name: str) -> NavigationResult:
        if self.protocol.is_dry_run:
            return NavigationResult(
                reached=True,
                status=self.config.arrived_status,
                text="dry-run arrival",
                target_name=poi_name,
            )

        deadline = monotonic() + self.config.navigation_timeout_seconds

        while monotonic() < deadline:
            message = self.protocol.receive_until(
                lambda msg: msg.topic == self.config.navi_status_topic,
                timeout_seconds=1.0,
            )

            if message is None:
                continue

            status, text = self._parse_navigation_status(message)
            self._last_navigation_status = status
            self._last_navigation_text = text

            if status == self.config.arrived_status:
                return NavigationResult(True, status, text, poi_name)

            if status in {self.config.canceled_status, self.config.failed_status}:
                return NavigationResult(False, status, text, poi_name)

            sleep(0.05)

        return NavigationResult(
            reached=False,
            status=self._last_navigation_status,
            text=f"Timed out waiting for {poi_name}: {self._last_navigation_text}",
            target_name=poi_name,
        )

    def cancel_navigation(self) -> None:
        self.protocol.advertise(
            topic=self.config.cancel_goal_topic,
            message_type=self.config.cancel_goal_type,
            message_id="cancel_goal",
        )

        self.protocol.publish(
            topic=self.config.cancel_goal_topic,
            message_id="cancel_goal",
            msg={"stamp": "", "id": ""},
        )

    def emergency_stop(self, enabled: bool = True) -> None:
        self.protocol.advertise(
            topic=self.config.soft_stop_topic,
            message_type=self.config.soft_stop_type,
            message_id="set_estop",
        )

        self.protocol.publish(
            topic=self.config.soft_stop_topic,
            message_id="set_estop",
            msg={"data": enabled},
        )

    def shutdown(self) -> None:
        if self.config.stop_on_shutdown:
            self.cancel_navigation()
        self.protocol.close()
        print("PlatformController shutdown complete")
